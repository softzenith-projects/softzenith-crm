# Environment for the API. Local development needs none of these (see application.yml defaults);
# with the prod profile the DB_* and CRM_AUTH_TOKEN_SECRET values are required.
DB_URL=
DB_USER=
DB_PASSWORD=
# Staff phone + sign-in code sessions. Secret: at least 32 random characters; required with the prod profile.
CRM_AUTH_TOKEN_SECRET=
# Optional: Supabase Auth project (https://<ref>.supabase.co) whose sign-ins are also accepted (email, AUTH2).
SUPABASE_URL=
FRONTEND_URL=
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
# Shared with tenant websites on another host (Vercel) so the API sees the visitor's address. 32+ random characters;
# the website sets the same value as CRM_PROXY_SECRET. Empty = forwarded visitor addresses are ignored.
CRM_TRUSTED_PROXY_SECRET=
# Cloudflare Turnstile secret for the public enquiry form. Empty = captcha not required.
TURNSTILE_SECRET=
# SoftZenith platform admin (/platform). Secret: at least 32 random characters; required with the prod profile.
CRM_PLATFORM_JWT_SECRET=
# First platform admin, created on startup only when none exists. Password: at least 12 characters.
# Remove both after the first start; the account stays.
CRM_PLATFORM_ADMIN_USERNAME=
CRM_PLATFORM_ADMIN_PASSWORD=
