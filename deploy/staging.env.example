# Staging settings. deploy/setup-env.sh copies this to deploy/.env and fills every empty secret marked GENERATED
# with a fresh random value. deploy/.env is never committed.

# Addresses (DNS A records must point at the server)
CRM_DOMAIN=crm-staging.softzenithlabs.com
CRM_API_DOMAIN=crm-staging-api.softzenithlabs.com
MAIL_DOMAIN=crm-staging-mail.softzenithlabs.com

# API
SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:postgresql://db:5432/crm
DB_USER=crm_app
# GENERATED
DB_PASSWORD=
# GENERATED (staff sessions)
CRM_AUTH_TOKEN_SECRET=
# GENERATED (SoftZenith console sessions)
CRM_PLATFORM_JWT_SECRET=
FRONTEND_URL=https://crm-staging.softzenithlabs.com

# Email: everything goes to the test inbox (Mailpit) on staging
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@softzenithlabs.com
# GENERATED (test inbox login, user "softzenith")
MAILPIT_PASSWORD=

# First SoftZenith console admin, created on the first start. Remove both lines after signing in once.
CRM_PLATFORM_ADMIN_USERNAME=softzenith
# GENERATED
CRM_PLATFORM_ADMIN_PASSWORD=

# Not used yet on staging
TURNSTILE_SECRET=
CRM_TRUSTED_PROXY_SECRET=
SUPABASE_URL=
