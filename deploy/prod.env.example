# Prod settings (all businesses' real data). `deploy/setup-env.sh prod` copies this to deploy/.env, fills every empty
# value under "# GENERATED" with a fresh random secret and asks for the values under "# ASK". deploy/.env is never
# committed. Prod runs only `main` (deploy/deploy.sh refuses other branches here).
DEPLOY_ENV=prod

# Addresses (DNS A records must point at the server)
CRM_DOMAIN=crm.softzenithlabs.com
CRM_API_DOMAIN=crm-api.softzenithlabs.com

# API
SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:postgresql://db:5432/crm
FRONTEND_URL=https://crm.softzenithlabs.com

# Database roles (deploy/db-init/10-roles.sh): a superuser that can only be used from inside the database container,
# an owner that runs the migrations, and the app's own login that can only read and write rows.
DB_SUPERUSER=postgres
# GENERATED
DB_SUPERUSER_PASSWORD=
DB_MIGRATION_USER=crm_owner
# GENERATED
DB_MIGRATION_PASSWORD=
DB_USER=crm_app
# GENERATED
DB_PASSWORD=

# GENERATED (staff sessions)
CRM_AUTH_TOKEN_SECRET=
# GENERATED (SoftZenith console sessions)
CRM_PLATFORM_JWT_SECRET=
# GENERATED (tenant websites on Vercel get the same value as CRM_PROXY_SECRET, for the per-visitor rate limits)
CRM_TRUSTED_PROXY_SECRET=

# Email through Google Workspace SMTP (docs/go-live.md step 1.5). Amazon SES later (MAIL1) changes only these lines.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
# ASK Google Workspace user that sends the emails (e.g. support@calrify.app)
MAIL_USERNAME=
# ASK-SECRET App password of that user (16 letters, myaccount.google.com/apppasswords)
MAIL_PASSWORD=
MAIL_FROM=noreply@softzenithlabs.com

# First SoftZenith console admin, created on the first start. Remove both lines after signing in once.
CRM_PLATFORM_ADMIN_USERNAME=softzenith
# GENERATED
CRM_PLATFORM_ADMIN_PASSWORD=

# Not used yet
TURNSTILE_SECRET=
SUPABASE_URL=

# Memory for a 6 GB server (database cache, Java heap)
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE_SIZE=3GB
PG_MAX_CONNECTIONS=40
API_JAVA_OPTS=-Xms768m -Xmx1536m -XX:MaxMetaspaceSize=256m -XX:+UseSerialGC

# Nightly backups (deploy/backup.sh) are also copied to this S3 bucket with the server's upload-only key
# (~/.aws of the server user, profile below). Empty = backups stay on the server only.
# ASK S3 bucket for the nightly backups
S3_BACKUP_BUCKET=
S3_BACKUP_PROFILE=softcrm-backup

# Error tracking (Sentry, org softzenith-softwares-private-l, projects softcrm-api / softcrm-web). Empty = off.
# The DSNs are not secret (they only allow sending errors), but they stay out of Git to avoid spam.
SENTRY_API_DSN=
SENTRY_WEB_DSN=
